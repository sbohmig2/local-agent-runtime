  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "zod": "4.3.6"
  }
}
